# ═══════════════════════════════════════════════════════
# SHORTKEY — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ═══════════════════════════════════════════════════════

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3005
# Production beauty: https://shortkey.beauty (or https://shortkey.vercel.app)
# Production live host (same Vercel project): https://shortkey.live → /live Coming Soon
# Attach shortkey.live in Vercel Domains — see CONNECTIONS.md §5

# Coming soon gate (production). Local npm run dev shows full site.
# COMING_SOON=false
SITE_ACCESS_PASSWORD=

# Internal staging soft gate (shortkey.studio / Family Table / private magazine showcase)
# When set: Family Table + Studio paths, plus /showcase, /magazine-demo, /control-center/magazine-demo
# require cookie unlock via /internal/login.
# Localhost + npm run family:dev / studio:dev / maya:dev bypass. Soft shared-secret only — not 正式版 auth.
# Prefer FAMILY_TABLE_STAGING_PASSWORD; INTERNAL_STAGING_SECRET is an accepted alias.
# Set the same key in Vercel project env (Production + Preview) — never commit the real password.
FAMILY_TABLE_STAGING_PASSWORD=
# INTERNAL_STAGING_SECRET=
# Attach shortkey.studio in Vercel Domains — see CONNECTIONS.md §6 (INTERNAL STAGING ONLY)

# Family Home v0.9.2 — Shared Doorbell store (server only · never expose to frontend)
# Prefer Upstash Redis REST OR Vercel KV REST for durable cross-device sync on Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Local/dev default: JSON file at data/family-doorbell.json (NODE_ENV=development).
# Force file store outside development:
# FAMILY_DOORBELL_FILE_STORE=1
# If none of the above: in-memory ephemeral · API returns shared:false · mode:"ephemeral"

# Optional: webhook for creator/brand meeting signup notifications (Slack, Make, Zapier, etc.)
# SIGNUP_NOTIFY_WEBHOOK_URL=https://hooks.example.com/...

# Meeting signup emails go to info@shortkey.beauty
# Option A (recommended): Resend — https://resend.com
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Shortkey <noreply@your-verified-domain.com>
# Option B (default): FormSubmit.co — first request may ask you to confirm info@shortkey.beauty

# ── Permanent connection chain (see CONNECTIONS.md) ────
# Repo → GitHub KieranSimpee/shortkey → Vercel → Base44 → Shopify
# Do not recreate these apps/stores — only rotate secrets.

# Locked Base44 defaults (override only if migrating — never for routine deploys)
SHORTKEY_PRODUCTS_API_URL=https://app.base44.com/api/apps/69ddc914cfcf229762ac123d/functions/getShortKeyProducts
# Senti bridge is hardcoded to app 6a42029cc124d0206f027335 in src/lib/senti-bridge.ts

# ── Base44 AI agents (4) + humans (2) ────────────────────────────────
# Shared API key for ALL four AI agents (same value in both vars):
#   Kura · Gor Gor (Simpee) · Senti · Agent R
# Get key: any agent Editor → Settings → Developer → API Key
# Prefer KURA_API_KEY; BASE44_API_KEY is the accepted alias (same key).
KURA_API_KEY=
BASE44_API_KEY=

# Agent IDs + locked conversation IDs (override only if Base44 migrates)
KURA_AGENT_ID=6a54198bebbee048f44e1378
GOR_GOR_AGENT_ID=69ddc914cfcf229762ac123d
GOR_GOR_CONVERSATION_ID=69ddc9166e1e12f6313fc523
SENTI_AGENT_ID=6a42029cc124d0206f027335
SENTI_CONVERSATION_ID=6a42029ee7bbd796cda145e3
AGENT_R_AGENT_ID=6a449e8691d185359beef333
AGENT_R_CONVERSATION_ID=6a449e88110fe595b96cbb05

# Humans / seats
# Sky = Social Room · email only
SKY_EMAIL=sky@shortkey.beauty

# Maya = Editorial Heart · ASI:One only (Base44 Maya portal DELETED 2026-08-07)
# Do NOT add MAYA_PORTAL_URL · MAYA_API_KEY · MAYA_AGENT_ID
# npm run ask:maya -- "…"  → ASI:One chat
# Lab: npm run maya:dev → http://127.0.0.1:3008/internal/maya

# npm: ask:kura | ask:gorgor | ask:senti | ask:agent-r | ask:maya
# Gor Gor CLI (step 1 scaffold): npm run ask:gorgor -- "…"
#   needs BASE44_AGENT_API_KEY in .env.local (see Gor Gor Chat Bridge block below)

# ASI:One — Maya live API + agentic LLM (one key)
# Docs: https://docs.asi1.ai/documentation/getting-started/overview
# Prefer ASI_ONE_API_KEY; ASI1_API_KEY is an accepted alias
ASI_ONE_API_KEY=
# ASI1_API_KEY=
# ASI1_MODEL=asi1

# DeepSeek — server-only support AI (reason / JSON / copy / code / prompts)
# NEVER Banuba TINT. Never put this key in frontend.
# Routes: POST /api/ai/deepseek/{clean-json|write-copy|reason|code-review|prompt-improve}
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional model override (defaults: deepseek-v4-flash · reason/code-review use deepseek-v4-pro)
# DEEPSEEK_MODEL=

# Gor Gor Chat Bridge v0.1 — server-side Base44 Superagent (Family Home only)
# Prefer BASE44_AGENT_API_KEY for /api/gor-gor-chat (never expose to frontend).
# Fallbacks read by server: BASE44_API_KEY · KURA_API_KEY
# Agent ID default in code: 69ddc914cfcf229762ac123d — override with SIMPEE_AGENT_ID
BASE44_AGENT_API_KEY=
BASE44_AGENT_API_BASE_URL=https://app.base44.com/api/agents
SIMPEE_AGENT_ID=69ddc914cfcf229762ac123d

# Minion Relay — Base44 app backend (chat/relay Message entity)
# App ID locked in code: 6a5f20ace942aedd542584a2
# Get key: Base44 Minion app Editor → Settings → Developer → API Key
# Prefer K_MINION_API_KEY; KMINION is an accepted alias. Never commit the real key.
# Routes: GET/POST /api/minion/relay · verify: npm run minion:verify
K_MINION_API_KEY=your_key_here
# KMINION=

# Locked Shopify store (Custom App tokens go below)
SHOPIFY_STORE_DOMAIN=simplex-ity-dev.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=simplex-ity-dev.myshopify.com

# mock | live  (UI hint — also set keys below for live)
NEXT_PUBLIC_COMMERCE_MODE=mock

# stripe | shopify | dual | mock
COMMERCE_PROVIDER=dual

# ── Stripe ────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Get from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_

# Optional: pre-create a Price in Stripe for the founding brand fee
# If blank, ad-hoc price_data is used at $FOUNDING_BRAND_FEE_USD
STRIPE_FOUNDING_BRAND_PRICE_ID=price_
FOUNDING_BRAND_FEE_USD=5000

# ── Shopify ───────────────────────────────────────────
# Store: simplex-ity-dev.myshopify.com (locked — see CONNECTIONS.md)
# Get tokens from: Shopify Admin → Apps → Custom App → Storefront / Admin API
# Domain already set above in Permanent connection chain section.

# Storefront API access token (read products, create carts)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API access token (optional — for webhook verification, inventory)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Get from: Shopify Admin → Settings → Notifications → Webhooks → Signing secret
SHOPIFY_WEBHOOK_SECRET=

# Shopify API version — update annually
SHOPIFY_API_VERSION=2025-01

# ── TINT Virtual Try-On ───────────────────────────────
# Get from: TINT merchant dashboard
NEXT_PUBLIC_TINT_MERCHANT_ID=

# ═══════════════════════════════════════════════════════
# WIRING CHECKLIST (run through in order):
# 1. Fill STRIPE keys → test founding brand fee on /brands
# 2. Fill SHOPIFY keys → add variant GIDs to src/lib/commerce/sku-map.ts
# 3. Set NEXT_PUBLIC_COMMERCE_MODE=live
# 4. Register webhooks in Stripe + Shopify dashboards
# 5. Set COMMERCE_PROVIDER=dual for both gateways
# ═══════════════════════════════════════════════════════
